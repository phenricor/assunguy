{
  "name": "assunguy",
  "private": true,
  "version": "1.0.0-beta.2",
  "description": "Assunguy: a colony-building game set in 19th-century Paraná.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/data packages/i18n packages/sim tools/bot",
    "balance": "pnpm --filter @assunguy/bot run balance"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
